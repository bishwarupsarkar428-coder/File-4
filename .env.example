# ---- Optional ----
# Private channel used by /universal_link (add the bot as admin). Example: -1001234567890
# DB_CHANNEL=
# Set to true to let ALL users use /genlink, /batch, /custom_batch and /shortener
# PUBLIC_LINKS=false
# Secret used to sign channel links. Use the SAME value on all your clones
# so /universal_link links work on every one of them. Defaults to BOT_TOKEN.
# LINK_SECRET=
# Link shortener (any service with an "/api?api=KEY&url=LINK" style API)
# SHORTENER_URL=gplinks.in
# SHORTENER_API=your_api_key
# Folder for the database. Mount a persistent volume here in production.
# DATA_DIR=data
